# Copy to .env and fill in. .env is gitignored — never commit real values.

# Stage [3] selector. Free tier: https://console.groq.com
# Leave unset and the selector uses the recorded fixture + deterministic fallback.
GROQ_API_KEY=

# Stage [5] execution. Razorpay TEST MODE keys only.
# Leave unset and the MockAdapter is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
